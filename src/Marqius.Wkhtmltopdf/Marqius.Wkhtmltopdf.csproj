<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Marqius.Wkhtmltopdf</PackageId>
    <AssemblyName>Marqius.Wkhtmltopdf</AssemblyName>
    <RootNamespace>Marqius.Wkhtmltopdf</RootNamespace>
    <Title>Marqius.Wkhtmltopdf: wkhtmltopdf for .NET, maintained</Title>
    <Description>wkhtmltopdf for .NET in one package: marqius-wkhtmltopdf, the maintained drop-in replacement for wkhtmltopdf, for Windows, Linux (x64, ARM64, Alpine) and macOS. The same command line and options, so Rotativa and other libraries that run wkhtmltopdf work as before. No Qt, no X server, nothing else to install.</Description>
    <PackageTags>wkhtmltopdf;wkhtmltoimage;html-to-pdf;html2pdf;htmltopdf;pdf;pdf-generation;pdf-converter;rotativa;nreco;aspnetcore;dotnet;csharp;docker;linux;alpine;marqius</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <!-- the program is the package: no lib folder warning for a package that is mostly native files -->
    <NoWarn>$(NoWarn);NU5100;NU5129</NoWarn>
    <!-- where build.py laid out the checked programs: runtimes/<rid>/native/ and Builds.cs -->
    <MarqiusBuilds Condition="'$(MarqiusBuilds)' == ''">$(MSBuildThisFileDirectory)../../builds/</MarqiusBuilds>
    <!-- safe to trim, and to publish as Native AOT (checked by tests/customer.py aot) -->
    <IsTrimmable Condition="'$(TargetFramework)' == 'net8.0'">true</IsTrimmable>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- each program as GitHub's release workflow built it, checked by build.py against its SHA-256 and provenance -->
    <None Include="$(MarqiusBuilds)runtimes/**/*" Pack="true" PackagePath="runtimes/" Visible="false" />
    <None Include="build/Marqius.Wkhtmltopdf.targets" Pack="true" PackagePath="build/;buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Condition="Exists('../../icon.png')" />
  </ItemGroup>

  <!-- the version and each program's SHA-256, written by build.py; a build without them checks no digest -->
  <ItemGroup Condition="Exists('$(MarqiusBuilds)Builds.cs')">
    <Compile Include="$(MarqiusBuilds)Builds.cs" Link="Builds.cs" />
    <Compile Remove="Builds.Dev.cs" />
  </ItemGroup>

</Project>
