<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Marqius.DinkToPdf</PackageId>
    <!-- the assembly keeps DinkToPdf's name and namespace, so an app's code and its using lines stay as they are -->
    <AssemblyName>DinkToPdf</AssemblyName>
    <RootNamespace>DinkToPdf</RootNamespace>
    <Title>DinkToPdf, with marqius-wkhtmltopdf in place of libwkhtmltox</Title>
    <Description>DinkToPdf's API (namespace DinkToPdf: SynchronizedConverter, PdfTools, HtmlToPdfDocument, every setting), on marqius-wkhtmltopdf, the maintained drop-in replacement for wkhtmltopdf. Replace the DinkToPdf package with this one and delete libwkhtmltox: your code stays as it is. No native library to load, so no "Unable to load shared library 'libwkhtmltox'" and no BadImageFormatException; each PDF is made in its own process, so conversions run side by side. Windows, Linux (Alpine too) and macOS. marqius-wkhtmltopdf is commercial, with a 30-day free trial; free for personal, teaching and open-source use.</Description>
    <PackageTags>dinktopdf;wkhtmltopdf;libwkhtmltox;html-to-pdf;pdf;aspnetcore;marqius</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <!-- safe to trim, and to publish as Native AOT (checked by tests/customer.py aot) -->
    <IsTrimmable Condition="'$(TargetFramework)' == 'net8.0'">true</IsTrimmable>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
    <!-- DinkToPdf's own WkHtmlToXBindings takes byte* buffers, as libwkhtmltox did -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Above DinkToPdf 1.0.8's 1.0.8.0, and fixed: an app or a library built against DinkToPdf loads
         this assembly in its place, and when the DinkToPdf package comes in too (through another
         package), the build picks this one. The package's own version is in the file and product
         versions. Checked by tests/api.py and tests/customer.py old-build. -->
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Marqius.Wkhtmltopdf/Marqius.Wkhtmltopdf.csproj" />
    <InternalsVisibleTo Include="Marqius.DinkToPdf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE-DinkToPdf.txt" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Condition="Exists('../../icon.png')" />
  </ItemGroup>

</Project>
