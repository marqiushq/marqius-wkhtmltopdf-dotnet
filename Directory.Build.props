<Project>
  <!-- Shared by both packages. build.py sets Version to the release of marqius-wkhtmltopdf they carry
       (a fix to the packages alone adds a fourth number: 0.12.14.1). -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.12.14</Version>
    <Authors>Simple AI LLC</Authors>
    <Company>Simple AI LLC</Company>
    <Product>marqius-wkhtmltopdf</Product>
    <Copyright>Copyright (c) 2026 Simple AI LLC</Copyright>
    <PackageProjectUrl>https://marqius.com/wkhtmltopdf/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marqiushq/marqius-wkhtmltopdf-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- DinkToPdf's own types carry few doc comments; their names are the documentation users know -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
