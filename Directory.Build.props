<Project>
  <!-- Shared by both packages. build.py sets Version to the release of marqius-wkhtmltopdf they carry
       (a fix to the packages alone adds a fourth number: 0.12.14.1). -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.12.14</Version>
    <Authors>Simple AI LLC</Authors>
    <Company>Simple AI LLC</Company>
    <Product>marqius-wkhtmltopdf</Product>
    <Copyright>Copyright (c) 2026 Simple AI LLC</Copyright>
    <PackageProjectUrl>https://marqius.com/wkhtmltopdf/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marqiushq/marqius-wkhtmltopdf-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- every public type and member has IntelliSense text, and keeps it -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1572;CS1573;CS1574</WarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <MarqiusVersion Condition="'$(MarqiusVersion)' == ''">$(Version)</MarqiusVersion>
    <PackageReleaseNotes>Carries marqius-wkhtmltopdf $(MarqiusVersion), built and signed by GitHub. What is new in the program: https://github.com/marqiushq/marqius-wkhtmltopdf/releases/tag/v$(MarqiusVersion). Step-by-step manual: https://github.com/marqiushq/marqius-wkhtmltopdf-dotnet/blob/main/docs/manual.md</PackageReleaseNotes>
    <!-- the netstandard2.0 and net8.0 builds keep the same public API -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
</Project>
