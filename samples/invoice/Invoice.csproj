<Project Sdk="Microsoft.NET.Sdk">

  <!-- The invoice on the package's page, made by Marqius.DinkToPdf from the HTML in templates/: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Marqius.DinkToPdf" Version="0.12.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="templates\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
